          "editorMode": "code",
          "expr": "sum by (broker_id) (max without (instance, pod) (maas_discrepancy_registered_entities{namespace=~\"$namespace\", container=~\"$service_name\", broker_type=\"Kafka\", broker_id=~\"$kafka_broker\", entity_namespace=~\"$entity_namespace\", tenant_id=~\"$tenant_id\"})) - sum by (broker_id) (max without (instance, pod) (maas_discrepancy_lost_entities{namespace=~\"$namespace\", container=~\"$service_name\", broker_type=\"Kafka\", broker_id=~\"$kafka_broker\", entity_namespace=~\"$entity_namespace\", tenant_id=~\"$tenant_id\"}))",
